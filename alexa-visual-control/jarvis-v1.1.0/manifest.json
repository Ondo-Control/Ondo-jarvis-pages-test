{
  "manifest_version": 3,
  "name": "ONDO JARVIS Control",
  "version": "1.1.0",
  "description": "Isolated visible-only control for the Ondo Jarvis Alexa Developer Console and its exact VoiceHub AWS console resources.",
  "permissions": [
    "debugger",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://developer.amazon.com/*",
    "https://eu-west-1.console.aws.amazon.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://developer.amazon.com/*",
        "https://eu-west-1.console.aws.amazon.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ONDO JARVIS Control"
  }
}
