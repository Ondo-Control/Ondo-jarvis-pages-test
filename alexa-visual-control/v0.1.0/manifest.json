{
  "manifest_version": 3,
  "name": "ONDO Alexa Visual Control",
  "version": "0.1.0",
  "description": "Isolated visible-only mouse/keyboard control for the Ondo Jarvis Alexa Developer Console skill.",
  "permissions": [
    "debugger",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://developer.amazon.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://developer.amazon.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ONDO Alexa Visual Control"
  }
}
